    {
      "parameters": {
        "jsCode": "const extract = $('Extract Order Information').first().json;\nconst order = extract.output;\n\nconst products = $input.all().map(item => item.json);\n\nconst requestedProduct = String(order.product_name || '')\n  .trim()\n  .toLowerCase();\n\n// Normalize product names and common user variations\nfunction normalizeProductName(name) {\n  return String(name || '')\n    .toLowerCase()\n    .trim()\n    .replace(/[-_]/g, ' ')\n    .replace(/\\s+/g, ' ')\n    .replace(/\\b(tee|tees)\\b/g, 't shirt')\n    .replace(/\\b(tshirts|t-shirts|tshirt)\\b/g, 't shirt')\n    .replace(/\\b(hoodies)\\b/g, 'hoodie')\n    .replace(/\\b(shoes)\\b/g, 'shoes')\n    .replace(/\\b(caps)\\b/g, 'cap')\n    .replace(/\\b(back packs)\\b/g, 'backpack');\n}\n\nconst normalizedRequested = normalizeProductName(requestedProduct);\n\nconst product = products.find(p => {\n  const productName = normalizeProductName(p['Product Name']);\n\n  if (productName === normalizedRequested) {\n    return true;\n  }\n\n  // Common variations\n  if (\n    productName === 'basic t shirt' &&\n    ['t shirt', 'basic shirt', 'basic tee', 'basic t'].includes(normalizedRequested)\n  ) {\n    return true;\n  }\n\n  if (\n    productName === 'oversized hoodie' &&\n    ['hoodie', 'oversized hoodies'].includes(normalizedRequested)\n  ) {\n    return true;\n  }\n\n  if (\n    productName === 'running shoes' &&\n    ['running shoe', 'trainers'].includes(normalizedRequested)\n  ) {\n    return true;\n  }\n\n  if (\n    productName === 'classic cap' &&\n    ['cap', 'classic caps'].includes(normalizedRequested)\n  ) {\n    return true;\n  }\n\n  if (\n    productName === 'backpack' &&\n    ['back pack', 'bag', 'school backpack'].includes(normalizedRequested)\n  ) {\n    return true;\n  }\n\n  return false;\n});\n\nif (!product) {\n  return [{\n    json: {\n      valid: false,\n      reason: 'product_not_found',\n      message: `Sorry, we couldn't find \"${order.product_name}\" in our products.`\n    }\n  }];\n}\n\nconst quantity = Number(order.quantity);\nconst stock = Number(product.Stock);\n\nif (!quantity || quantity <= 0 || !Number.isInteger(quantity)) {\n  return [{\n    json: {\n      valid: false,\n      reason: 'invalid_quantity',\n      message: 'Please provide a valid quantity.'\n    }\n  }];\n}\n\nif (quantity > stock) {\n  return [{\n    json: {\n      valid: false,\n      reason: 'out_of_stock',\n      message: `Sorry, we only have ${stock} unit(s) of ${product['Product Name']} available.`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    product_id: product['Product ID'],\n    product_name: product['Product Name'],\n    price: Number(product.Price),\n    stock,\n    quantity,\n    size: order.size,\n    color: order.color,\n    total: Number(product.Price) * quantity\n  }\n}];"
      },
